# Copy this file to .env and fill it in. .env is git-ignored; never commit real keys.

# Vault keys: create both with `python -m src.vault` (do not type them by hand).
# Back them up somewhere safe: without them the vault can never be unlocked.
VAULT_ENCRYPTION_KEY=
VAULT_INDEX_KEY=

# OpenAI: used only by src/answer.py (the AI only ever receives masked text).
OPENAI_API_KEY=

# Optional: change the model (default gpt-6-astra), e.g. a cheaper one.
# OPENAI_MODEL=gpt-6-luna
